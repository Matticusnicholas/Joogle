{
  "name": "joogle",
  "version": "1.0.0",
  "description": "Epstein Files Search Engine - Live search with expandable document grid and local LLM Q&A",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "build:static": "node scripts/build-static.js && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "ingest": "node server/ingest.js",
    "setup": "npm install && npm run ingest && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^6.0.0"
  }
}
